# Copie en .env et remplis. Tout est optionnel sauf GROQ_API_KEY (pour la conversation).
GROQ_API_KEY=
# Écho : ton propre serveur de transcription au format OpenAI (/v1/audio/transcriptions), par ex. Parakeet
# sur une machine de la maison. Vide = ignoré.
ECHO_URL=
ECHO_API_KEY=
# Ordre des moteurs de transcription (le suivant prend le relais si le premier échoue).
# Mesuré sur une question de 3,4 s : Groq 0,33 s, Écho 1,7 à 2,7 s, même texte. echo,groq = ta voix reste à la maison.
STT_PROVIDERS=groq,echo
STT_LANGUAGE=fr
GROQ_STT_MODEL=whisper-large-v3-turbo
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
# Voix de départ : piper (Siwis) ou say (voix macOS SAY_VOICE). Ensuite, elle se choisit dans Réglages.
TTS=piper
SAY_VOICE=Thomas
# Modèle MDX-Net qui isole la voix des morceaux (téléchargé par run.sh).
SEPARATOR_MODEL=voices/Kim_Vocal_2.onnx
HOST=127.0.0.1
PORT=5280
# Où le cerveau envoie ses clips (vide = ce serveur ; plus tard l'IP de l'ESP32).
FACE_URL=
