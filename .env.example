# Copy to .env and fill in. Everything is optional except a brain: GROQ_API_KEY or LLM_URL.
GROQ_API_KEY=
# The language Eli speaks: auto (the page's browser language, which Settings can override), en or fr.
ELI_LANG=auto
# Echo: your own OpenAI-style transcription server (/v1/audio/transcriptions), e.g. Parakeet
# on a machine at home. Empty = ignored.
ECHO_URL=
ECHO_API_KEY=
# Order of the transcription engines (the next one takes over if the first fails).
# Measured on a 3.4 s question: Groq 0.33 s, Echo 1.7 to 2.7 s, same text. echo,groq = your voice stays home.
STT_PROVIDERS=groq,echo
# Transcription language (fr, en…). Empty = follows ELI_LANG.
STT_LANGUAGE=
GROQ_STT_MODEL=whisper-large-v3-turbo
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
# Local OpenAI-style brain instead of Groq, e.g. mlx_lm.server (http://127.0.0.1:8080/v1, LLM_MODEL=
# mlx-community/Qwen3-8B-4bit) or Ollama (http://127.0.0.1:11434/v1, LLM_MODEL=qwen3:8b). Empty = Groq.
LLM_URL=
LLM_API_KEY=
# Starting voice: piper (Siwis in French, Kristin in English) or say (macOS voice SAY_VOICE, if it speaks the
# language). Then it's chosen in Settings, one per language.
TTS=piper
SAY_VOICE=Thomas
# MDX-Net model that isolates the voice in songs (downloaded by run.sh).
SEPARATOR_MODEL=voices/Kim_Vocal_2.onnx
HOST=127.0.0.1
PORT=5280
# Where the brain sends its clips (empty = this server; later the ESP32's IP).
FACE_URL=
# City for the morning brief's weather (Open-Meteo, no key). Empty = morning brief without weather.
BRIEF_CITY=
# Domain names served besides IPs and localhost (e.g. eli.your-tailnet.ts.net behind tailscale serve).
ALLOWED_HOSTS=
# Synced lyrics from LRCLIB while he sings (sends artist + title to lrclib.net). off = never ask.
LYRICS=on
# Your music (Navidrome / Subsonic): easier from the Music panel (♪ in the dock), which only keeps a token.
NAVIDROME_URL=
NAVIDROME_USER=
NAVIDROME_PASSWORD=
